# Kết nối MySQL Cloud (TiDB Cloud Starter / Aiven / Railway / VPS)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_prefix.root
DB_PASSWORD=your-tidb-password
DB_NAME=flappy_bird_db

# TiDB Cloud Starter dùng VERIFY_IDENTITY (tự xác thực qua certifi, không cần đặt DB_SSL_CA)
DB_SSL_MODE=VERIFY_IDENTITY
DB_SSL_CA=
DB_SSL_CA_PEM=

# Chuỗi bí mật ký JWT (đổi sang chuỗi ngẫu nhiên >= 32 ký tự khi lên Production)
JWT_SECRET=replace-with-a-strong-random-secret-key-at-least-32-chars
JWT_EXPIRE_HOURS=720

# Tự động khởi tạo bảng từ schema.sql nếu bảng Player chưa tồn tại (true/false)
AUTO_INIT_DB=true

# Cổng HTTP API (Render/Railway tự gán PORT)
PORT=8000
CORS_ORIGINS=*
